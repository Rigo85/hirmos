{
  "name": "hirmos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @hirmos/contracts && npm run build -w @hirmos/domain && npm run build -w @hirmos/api && npm run build -w @hirmos/web",
    "build:api": "npm run build -w @hirmos/contracts && npm run build -w @hirmos/domain && npm run build -w @hirmos/api",
    "build:web": "npm run build -w @hirmos/contracts && npm run build -w @hirmos/web",
    "dev:api": "npm run build -w @hirmos/contracts && npm run build -w @hirmos/domain && npm run dev -w @hirmos/api",
    "dev:web": "npm run build -w @hirmos/contracts && npm run start -w @hirmos/web",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run e2e -w @hirmos/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:migrate": "npm run db:migrate -w @hirmos/api",
    "auth:bootstrap-admin": "npm run auth:bootstrap-admin -w @hirmos/api",
    "source:configure": "node scripts/configure-source.mjs",
    "history:import": "node scripts/import-listen-history.mjs",
    "catalog:warm-habits": "node scripts/warm-habits-catalog.mjs",
    "catalog:link-artists": "node scripts/link-artist-identities.mjs",
    "cue:split": "node tools/cue-splitter/index.mjs",
    "cue:split:test": "node --test tools/cue-splitter/*.test.mjs",
    "smoke:cache": "node scripts/smoke-cache.mjs",
    "smoke:cache-source": "node scripts/smoke-cache-source.mjs",
    "smoke:auth": "node scripts/smoke-auth-flow.mjs",
    "smoke:playback": "node scripts/smoke-playback.mjs",
    "audio-lab": "vite --config tools/audio-eq-lab/vite.config.ts",
    "audio-lab:build": "vite build --config tools/audio-eq-lab/vite.config.ts",
    "audio-lab:test": "vitest run --config tools/audio-eq-lab/vitest.config.ts",
    "audio-lab:typecheck": "tsc --noEmit -p tools/audio-eq-lab/tsconfig.json"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "argon2@0.45.1": true,
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  }
}
