{
  "name": "@hirmos/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "node dist/db/migrate.js",
    "auth:bootstrap-admin": "node dist/auth/bootstrap-admin.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/static": "^10.1.3",
    "@hirmos/contracts": "*",
    "@hirmos/domain": "*",
    "argon2": "^0.45.1",
    "fastify": "^5.12.1",
    "nodemailer": "^9.1.1",
    "pg": "^8.23.0",
    "saxes": "^6.0.0",
    "socket.io": "^4.8.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.16.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
