{
  "$schema": "../../node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "hirmos-application",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/index.html",
          "/*.js$",
          "!/*worker.js$",
          "!/**/*.map",
          "/*.css$",
          "/media/*.woff2$",
          "/favicon.ico",
          "/manifest.webmanifest",
          "/icons/**"
        ]
      }
    }
  ],
  "dataGroups": [],
  "navigationRequestStrategy": "performance",
  "navigationUrls": [
    "/**",
    "!/**/*.*",
    "!/api/**",
    "!/socket.io/**",
    "!/health/**",
    "!/__fixture/**"
  ]
}
