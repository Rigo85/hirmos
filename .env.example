# Runtime
NODE_ENV=development
HOST=127.0.0.1
PORT=3013
LOG_LEVEL=info
PUBLIC_ORIGIN=http://localhost:4200
# Comma-separated addresses of reverse proxies allowed to supply X-Forwarded-For.
TRUSTED_PROXIES=127.0.0.1

# Dedicated Hirmos resources only
DATABASE_URL=postgres://hirmos_app:change-me@127.0.0.1:55432/hirmos
# Used only by `npm run db:migrate` in production; never by the API process.
MIGRATION_DATABASE_URL=postgres://hirmos_migrator:change-me@127.0.0.1:5432/hirmos

# Source credentials are configured from the admin UI later.
# Exactly 32 bytes encoded as base64url; never commit the real value.
DATA_ENCRYPTION_KEY=

# Gmail is optional during local development. Prefer a capture provider locally.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_APP_PASSWORD_FILE=
MAIL_FROM=

# One-time admin bootstrap. Supply the password over stdin, never here.
HIRMOS_BOOTSTRAP_EMAIL=
